    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n  const data = item.json;\n\n  const ratingText = String(data[\"Guest Rating\"] || \"\");\n  const ratingScore = Number.parseInt(ratingText, 10);\n  const enquiryType = String(data[\"Enquiry Type\"] || \"\").trim();\n  const feedback = String(data[\"Feedback Message\"] || \"\");\n  const message = feedback.toLowerCase();\n\n  let category = \"General Feedback\";\n  let priority = \"Low\";\n  let issueType = \"General Experience\";\n  let assignedTeam = \"Guest Services\";\n\n  const foodSafetyTerms = [\n    \"food poisoning\", \"allergic reaction\",\n    \"contamination\", \"mold\", \"mould\",\n    \"foreign object\", \"got sick\"\n  ];\n\n  const queueTerms = [\n    \"queue\", \"long wait\", \"waiting\",\n    \"slow service\", \"waited\", \"overwhelmed\"\n  ];\n\n  const cleanlinessTerms = [\n    \"dirty\", \"messy\", \"unclean\",\n    \"hygiene\", \"filthy\"\n  ];\n\n  const hasFoodSafetyConcern = foodSafetyTerms.some(\n    term => message.includes(term)\n  );\n\n  const hasQueueConcern = queueTerms.some(\n    term => message.includes(term)\n  );\n\n  const hasCleanlinessConcern = cleanlinessTerms.some(\n    term => message.includes(term)\n  );\n\n  if (hasFoodSafetyConcern) {\n    category = \"Complaint\";\n    priority = \"High\";\n    issueType = \"Potential Food Safety\";\n    assignedTeam = \"Guest Services / Management\";\n  } else if (\n    enquiryType === \"Complaint\" ||\n    (ratingScore <= 2 && ratingScore >= 1)\n  ) {\n    category = \"Complaint\";\n    priority = \"Medium\";\n\n    if (hasQueueConcern) {\n      issueType = \"Service / Queue\";\n    } else if (hasCleanlinessConcern) {\n      issueType = \"Cleanliness\";\n    } else {\n      issueType = \"Guest Experience\";\n    }\n  } else if (enquiryType === \"Community Partnership\") {\n    category = \"Community Engagement\";\n    priority = \"Medium\";\n    issueType = \"Community Partnership\";\n    assignedTeam = \"Marketing / Community\";\n  } else if (\n    enquiryType === \"Event or Collaboration Enquiry\"\n  ) {\n    category = \"Community Engagement\";\n    priority = \"Medium\";\n    issueType = \"Event / Collaboration\";\n    assignedTeam = \"Marketing / Community\";\n  } else if (enquiryType === \"Suggestion\") {\n    category = \"Suggestion\";\n    issueType = \"Guest Suggestion\";\n    assignedTeam = \"Marketing / Guest Services\";\n  } else if (ratingScore >= 4) {\n    category = \"Compliment\";\n    issueType = \"Positive Experience\";\n  } else if (ratingScore === 3) {\n    category = \"General Feedback\";\n    issueType = \"Neutral Experience\";\n  }\n\n\n  \n\nconst submissionId =\n  \"YCHI-\" +\n  String(data.submittedAt || \"\")\n    .replace(/[^0-9]/g, \"\") +\n  \"-\" +\n  String(index);\n\n  return {\n    json: {\n      ...data,\n      submissionId,\n      ratingScore,\n      category,\n      priority,\n      issueType,\n      assignedTeam,\n      status: \"Pending Review\"\n    }\n  };\n});\n"
      },
